FROM fedora:41

ARG user=application
ARG httpd_package=httpd

RUN yum -y install $httpd_package unzip && yum clean all

LABEL maintainer="Ricardo"
LABEL vendor="companyB"
LABEL random="yay"

ENV HTML=beginner-html-site-styled

WORKDIR /var/www/html/

ADD https://github.com/mdn/${HTML}/archive/refs/heads/main.zip ./code.zip

RUN unzip code.zip && \
    mv ${HTML}-main/* . && \
    echo ${HTML} > ./env.html && \
    rm -rf code.zip ${HTML}-main/

RUN useradd $user && chown $user:$user /var/www/html -R

COPY cmd.sh /cmd.sh
RUN chmod +x /cmd.sh

USER $user

CMD ["/cmd.sh"]